# ==============================================================================
# CODEGUARD — Environment Configuration Template
# ==============================================================================

# Application Core
DJANGO_ENV=development
DJANGO_SETTINGS_MODULE=codeguard.settings.development
DEBUG=True
SECRET_KEY=dev-insecure-secret-key-change-in-production-min-50-chars-codeguard-platform-2026
ALLOWED_HOSTS=localhost,127.0.0.1,backend,0.0.0.0
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Database (MySQL 8)
DB_ENGINE=django.db.backends.mysql
DB_NAME=codeguard_db
DB_USER=codeguard_user
DB_PASSWORD=codeguard_secure_password
DB_HOST=127.0.0.1
DB_PORT=3306

# SQLite Fallback (Optional for standalone testing without MySQL running)
USE_SQLITE_DEV=False

# Cache, Channel Layers & Message Broker (Redis 7)
REDIS_URL=redis://127.0.0.1:6379/0
CELERY_BROKER_URL=redis://127.0.0.1:6379/1
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/2

# JWT Authentication
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7
JWT_SIGNING_KEY=jwt-dev-secret-key-change-in-production-codeguard

# Code Execution Sandbox (Judge0)
JUDGE0_API_URL=http://localhost:2358
JUDGE0_AUTH_TOKEN=
JUDGE0_TIMEOUT_SECONDS=10

# SQL Sandbox Execution
SQL_SANDBOX_HOST=127.0.0.1
SQL_SANDBOX_PORT=3307
SQL_SANDBOX_TIMEOUT_SECONDS=2

# Data Retention Lifecycle
RETENTION_PERIOD_DAYS=30
RETENTION_PURGE_BATCH_SIZE=50

# Media & Static Files
MEDIA_ROOT=media
STATIC_ROOT=staticfiles

# Frontend Environment Variables (Vite)
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_WS_BASE_URL=ws://localhost:8000/ws
